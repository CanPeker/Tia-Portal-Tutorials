FUNCTION_BLOCK "PartCounter"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      sensor : Bool;
      stop : Bool;
      start : Bool;
      reset : Bool;
      eStopOk : Bool;
   END_VAR

   VAR_OUTPUT 
      convOut : Bool;
      redLamp : Bool;
      greenLamp : Bool;
      yellowLamp : Bool;
      levelLamp : Bool;
   END_VAR

   VAR_IN_OUT 
      st : "station";
   END_VAR

   VAR RETAIN
      part_counter {InstructionName := 'CTU_INT'; LibVersion := '1.0'} : CTU_INT;
      timer1 {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR
   VAR 
      timerStep : Bool;
      startEdge {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      stopEdge {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      resetEdge {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
   END_VAR

   VAR_TEMP 
      partDetected : Bool;
      startPressed : Bool;
      stopPressed : Bool;
      counterResetPressed : Bool;
   END_VAR


BEGIN
	(*
	   STATE MACHINE
	   0    IDLE      — start bekle
	   20   RUNNING   — konveyör çalışıyor, parça sayıyor
	   30   SETTLE    — 1 sn bekleme (son parça yerleşsin)
	   40   FULL      — reset bekle
	   404  STOPPED   — acil çıkış, sayaç sıfırla, IDLE'a dön
	*)
	
	IF NOT #eStopOk THEN
	    #st.status.running := FALSE;
	    #st.status.step := 990;
	END_IF;
	IF #stopEdge.Q THEN
	    #st.status.running := FALSE;
	    #st.status.step  := 0;
	END_IF;
	
	
	// IO Normal
	#partDetected := NOT #sensor;
	#startPressed := #start;
	#stopPressed := NOT #stop;
	#counterResetPressed := #reset;
	
	
	//counter and timer def
	#part_counter(CU:= #partDetected, R:=#resetEdge.Q, PV:=#st.data.target);
	#timer1(IN := #timerStep,PT := T#1000ms);
	#startEdge(CLK := #startPressed);
	#stopEdge(CLK := #stopPressed);
	#resetEdge(CLK := #counterResetPressed);
	
	#st.data.count := #part_counter.CV;
	
	
	
	
	// main flow
	CASE  #st.status.step  OF
	        
	        
	    0:
	        IF (#startEdge.Q AND #st.cmd.enable) THEN
	            #st.status.running := TRUE;
	            #st.status.step  := 20;
	        END_IF;
	        
	    20:
	        IF #part_counter.QU THEN
	            #timerStep := 1;
	            IF #timer1.Q THEN
	                #st.status.running := FALSE;
	                #st.status.step  := 30;
	            END_IF;
	        END_IF;
	
	        
	    30:
	        
	        RESET_TIMER(#timer1);
	        #timerStep := 0;
	        #st.data.totalCount := #st.data.totalCount + #st.data.count;
	        #st.status.step  := 40;
	        
	    40:
	        IF #resetEdge.Q THEN
	            #st.status.step  := 0;
	        END_IF;
	        
	    990: //eStop Step
	      
	        IF #eStopOk AND #resetEdge.Q THEN
	            #st.status.step  := 0;
	        END_IF;
	        
	        ;
	        
	    ELSE
	        #st.status.step  := 0;
	        ;
	END_CASE;
	
	// out states 
	#convOut := (#st.status.running);
	#greenLamp := ( #st.status.step =20);
	#yellowLamp := ( #st.status.step  = 40);
	#levelLamp := ( #st.status.step  = 40);
	#redLamp := ( #st.status.step  = 990);
	
	#st.status.full := (#st.status.step = 40);
	
	#st.status.ready := #st.status.step = 0;
	
	#st.status.eStop := #st.status.step = 990;
	
	
	
	
	
	
END_FUNCTION_BLOCK

